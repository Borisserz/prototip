# ===== Единый .env для всего проекта (скопируйте в .env) =====

# --- LLM ---
# Ollama (локальная модель, по умолчанию)
OLLAMA_MODEL=qwen2.5-coder:7b-instruct
# Vertex / Gemini (альтернатива): USE_VERTEX=true + GOOGLE_APPLICATION_CREDENTIALS
USE_VERTEX=false
# AI_MODEL=gemini-3.5-flash
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp.json

# --- ClickHouse (значения для backend-контейнера выставляются в compose) ---
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DB=genbi

# --- Объектное хранилище MinIO (Phase 1) ---
STORAGE_BACKEND=minio            # local | minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Внешний URL для браузера (порт 9100 на хосте)
MINIO_PUBLIC_URL=http://localhost:9100
