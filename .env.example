# ===== Единый .env для всего проекта (скопируйте в .env) =====

# --- Безопасность / Auth (КРИТИЧНО для прода) ---
# Окружение: development | production. В production приложение НЕ стартует без
# сильного SECRET_KEY и предупреждает о демо-пользователях.
APP_ENV=development
# Ключ подписи JWT (≥32 символов / 256 бит). Сгенерируйте: openssl rand -hex 32
SECRET_KEY=
# Время жизни access-токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Разрешённые CORS-origins фронта (через запятую, без wildcard)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Локальные пользователи в JSON (переопределяет демо admin/grodno/minsk).
# Формат: {"login": {"hash": "$2b$...", "role": "admin"}}
# Хеш пароля: python -c "import bcrypt;print(bcrypt.hashpw(b'PASS',bcrypt.gensalt()).decode())"
LOCAL_USERS=

# --- LLM ---
# Ollama (локальная модель, по умолчанию)
OLLAMA_MODEL=qwen2.5-coder:7b-instruct
# --- Vertex / Gemini (режим по умолчанию) ---
# Стек по умолчанию работает на Vertex AI (USE_VERTEX=true). Чтобы всё
# заработало сразу после клонирования:
# 1) Положите ключ сервис-аккаунта GCP в ./backend/secrets/gcp.json
# 2) (опц.) укажите GOOGLE_CLOUD_PROJECT, если project_id не лежит в ключе
# Чтобы вместо Vertex использовать локальную Ollama — поставьте USE_VERTEX=false
# и поднимите профиль ollama: docker compose --profile ollama up -d ollama
USE_VERTEX=true
AI_MODEL=gemini-3.5-flash
# Путь ВНУТРИ контейнера (файл монтируется из ./secrets)
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp.json
# Опционально (если не берётся из ключа):
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=global

# --- ClickHouse (значения для backend-контейнера выставляются в compose) ---
# ВАЖНО: имя БД должно быть `default` — init.sql создаёт таблицы в default,
# а backend-код жёстко обращается к default.tax_data.
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DB=default

# --- Frontend (build-time) ---
# Базовый URL API встраивается в бандл при сборке frontend (build-arg в compose).
# Для локального запуска оставьте localhost:8000; при деплое укажите публичный URL.
VITE_API_BASE=http://localhost:8000

# --- Объектное хранилище MinIO (Phase 1) ---
STORAGE_BACKEND=minio            # local | minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Внешний URL для браузера (порт 9100 на хосте)
MINIO_PUBLIC_URL=http://localhost:9100

# --- Observability: Grafana (Phase 8, профиль observability) ---
# docker compose --profile observability up -d
# Grafana → http://localhost:3001  (логин/пароль ниже), Prometheus → http://localhost:9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ===== Phase 9: ETL-оркестрация (Apache Airflow, профиль etl) =====
# Запуск:  docker compose --profile etl up -d --build
# Airflow UI → http://localhost:8081  (admin/admin)
#
# ВАЖНО: ОБЩИЙ ключ шифрования backend ↔ Airflow. Без него Airflow не сможет
# расшифровать сохранённые DSN Postgres клиентов и пароли ClickHouse.
# Сгенерируйте свой:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_ENCRYPTION_KEY=
# REST API Airflow (backend дёргает его, чтобы запускать DAG'и по кнопке)
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
# Почта для алертов о сбоях ETL (через app/services/email_service.py; Telegram запрещён)
ETL_ALERT_EMAIL=admin@prototip.local
# SMTP (если не задать — письма только логируются)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@prototip.local
SMTP_PASS=secret
