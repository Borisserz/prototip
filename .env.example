# ===== Единый .env для всего проекта (скопируйте в .env) =====

# --- LLM ---
# Ollama (локальная модель, по умолчанию)
OLLAMA_MODEL=qwen2.5-coder:7b-instruct
# --- Vertex / Gemini (альтернатива Ollama) ---
# 1) Положите ключ сервис-аккаунта GCP в ./backend/secrets/gcp.json
# 2) Выставьте USE_VERTEX=true
USE_VERTEX=false
AI_MODEL=gemini-3.5-flash
# Путь ВНУТРИ контейнера (файл монтируется из ./secrets)
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp.json
# Опционально (если не берётся из ключа):
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=global

# --- ClickHouse (значения для backend-контейнера выставляются в compose) ---
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DB=genbi

# --- Объектное хранилище MinIO (Phase 1) ---
STORAGE_BACKEND=minio            # local | minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Внешний URL для браузера (порт 9100 на хосте)
MINIO_PUBLIC_URL=http://localhost:9100

# --- Observability: Grafana (Phase 8, профиль observability) ---
# docker compose --profile observability up -d
# Grafana → http://localhost:3001  (логин/пароль ниже), Prometheus → http://localhost:9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ===== Phase 9: ETL-оркестрация (Apache Airflow, профиль etl) =====
# Запуск:  docker compose --profile etl up -d --build
# Airflow UI → http://localhost:8081  (admin/admin)
#
# ВАЖНО: ОБЩИЙ ключ шифрования backend ↔ Airflow. Без него Airflow не сможет
# расшифровать сохранённые DSN Postgres клиентов и пароли ClickHouse.
# Сгенерируйте свой:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_ENCRYPTION_KEY=
# REST API Airflow (backend дёргает его, чтобы запускать DAG'и по кнопке)
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
# Почта для алертов о сбоях ETL (через app/services/email_service.py; Telegram запрещён)
ETL_ALERT_EMAIL=admin@prototip.local
# SMTP (если не задать — письма только логируются)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@prototip.local
SMTP_PASS=secret
